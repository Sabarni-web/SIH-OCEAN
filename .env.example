# ===================================================
# OCEAN VISTA / SIH-OCEAN ENVIRONMENT CONFIGURATION
# ===================================================

# --- Server & Runtime Settings ---
PORT=5000
NODE_ENV=development

# --- Backend API Endpoint (Consumed by Vite Frontend) ---
VITE_API_BASE_URL=http://localhost:5000/api

# --- Primary Oceanographic Data Provider ---
# Options: INCOIS | NOAA_ERDDAP | LOCAL_ONLY
DATA_PROVIDER=INCOIS
VITE_DATA_PROVIDER=INCOIS

# --- INCOIS Data Services Configuration ---
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap
VITE_INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap
INCOIS_ARGO_DATASET_ID=Indian_ARGO_Floats

# --- CARTO Basemap API Key (Optional: for CARTO Dark Matter Tiles) ---
VITE_CARTO_API_KEY=

# --- Alternate / Global Data Providers ---
NOAA_ERDDAP_URL=https://upwell.pfeg.noaa.gov/erddap

# --- MongoDB Storage (Optional: fallback to live API streaming if disconnected) ---
MONGO_URI=mongodb://localhost:27017/ocean-vista

# --- External API Base URLs ---

# NOAA_GRIDDAP_URL: Used to fetch generalized gridded 3D ocean data (e.g. Temperature).
NOAA_GRIDDAP_URL="https://coastwatch.pfeg.noaa.gov/erddap/griddap"

# NOAA_TABLEDAP_URL: Used to fetch exact station/sensor point data (e.g. Salinity).
NOAA_TABLEDAP_URL="https://coastwatch.pfeg.noaa.gov/erddap/tabledap"

# COPERNICUS_MARINE_URL: Used to fetch live ocean current velocity and wave data.
COPERNICUS_MARINE_URL="https://marine-api.open-meteo.com/v1/marine"

